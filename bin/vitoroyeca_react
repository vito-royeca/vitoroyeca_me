#!/bin/sh

# PROVIDE: vitoroyeca_react
# REQUIRE: LOGIN cleanvar
# KEYWORD: shutdown

# Put this script in /usr/local/etc/rc.d and make it executable. Then add
# "vitoroyeca_react_enable=YES" to /etc/rc.conf to enable it, i.e.:
# `cp bin/vitoroyeca_react /usr/local/etc/rc.d/vitoroyeca_react`
# `chmod a+x /usr/local/etc/rc.d/vitoroyeca_react`
# `service vitoroyeca_react enable`
# To start the service, run "service vitoroyeca_react start" or reboot the system.

PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"

. /etc/rc.subr

name="vitoroyeca_react"
workdir="/var/db/vitoroyeca_me"
npm_cmd="/usr/local/bin/npm run dev &"

start_cmd="${name}_start"
stop_cmd=":"

: ${dummy_svcj_options:=""}

vitoroyeca_react_start()
{
       su -m www -c "cd ${workdir} && ${npm_cmd}"
}

load_rc_config $name
run_rc_command "$1"